# --- Make.com webhook endpoints ---
# Create these as separate Make.com scenarios (each starting with a "Custom Webhook" trigger)
# and paste the generated webhook URLs here.

# Returns booked slots for a given date, checking Google Sheets + Google Calendar.
# Expected response: { "bookedSlots": ["14:00", "15:00"] }
VITE_AVAILABILITY_WEBHOOK_URL=https://hook.eu2.make.com/3oko0blnck61da70x751uscngntwpwf4

# Receives a new booking submission, runs the double-booking check, writes to
# Google Sheets, creates the Google Calendar event, and sends both emails.
# Expected response: { "success": true, "bookingId": "SN-XXXXX" }
# or on conflict: { "success": false, "reason": "slot_taken" }
VITE_BOOKING_WEBHOOK_URL=https://hook.eu2.make.com/hvrg8d8u427heuqvy7bts4ppdsujdqnj

# --- Business contact (used for footer / contact section / confirmation page) ---
# These are example/fictional values so the site reads naturally during
# development — swap each one for the real SupaNails detail before launch.
VITE_BUSINESS_PHONE=+234 801 234 5678
VITE_BUSINESS_EMAIL=hello@supanails.ng
VITE_BUSINESS_ADDRESS=12 Admiralty Way, Lekki Phase 1, Lagos
VITE_BUSINESS_INSTAGRAM=https://instagram.com/supanails.ng

# wa.me link used for the "squeeze-in appointment" note in the booking flow
# and the floating WhatsApp button. Format: https://wa.me/234XXXXXXXXXX
VITE_BUSINESS_WHATSAPP=https://wa.me/2348012345678
